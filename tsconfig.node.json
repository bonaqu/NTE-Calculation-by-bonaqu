{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "workers",
    "src/data.ts",
    "src/characters.ts",
    "src/gameTerms.ts",
    "src/arc-directory.ts",
    "src/arc-catalog.ts",
    "src/arc-presets.ts",
    "src/esper-cycles.ts",
    "src/rotation-presets.ts",
    "src/types.ts",
    "packages/calculation-core/src/index.ts"
  ]
}
