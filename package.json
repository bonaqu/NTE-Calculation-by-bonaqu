{
  "name": "nte-calculation-by-bonaqu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev --config workers/api/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config workers/api/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config workers/api/wrangler.jsonc"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0",
    "@types/node": "24.13.3"
  },
  "engines": {
    "node": ">=24"
  }
}
